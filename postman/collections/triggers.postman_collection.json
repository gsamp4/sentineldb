{
  "info": {
    "_postman_id": "f0e58c9b-0ed7-4c20-8f08-2462f6e6b03e",
    "name": "SentinelDB Triggers",
    "description": "Requests para disparar scans e consultar triggers da API SentinelDB.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "assetId",
      "value": "01ARZ3NDEKTSV4RRFFQ69G5FAA"
    }
  ],
  "item": [
    {
      "name": "Trigger All Active Assets",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/api/v1/trigger",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "trigger"]
        }
      }
    },
    {
      "name": "Trigger Specific Asset",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/api/v1/trigger/{{assetId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "trigger", "{{assetId}}"]
        },
        "description": "Dispara um scan para um asset especifico ja cadastrado. O parametro :id deve ser um assetId."
      }
    }
  ]
}
